<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="RegressionSuite">

    <!-- Every test class runs in its own thread; each class has its own browser. -->
    <test name="RegressionSuite" parallel="classes" thread-count="2">
        <packages>
            <package name="tests.*"></package>
        </packages>
    </test>

</suite>
