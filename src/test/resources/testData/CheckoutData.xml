<!--
    Test data for the checkout tests. The address is invented; example.com cannot receive email.
    <email> is left empty where the test generates a unique one.
-->
<dataSets>
    <guestOrder>
        <category>Books</category>
        <productName>Health Book</productName>
        <firstName>Alex</firstName>
        <lastName>Tester</lastName>
        <email></email>
        <country>Romania</country>
        <city>Bucharest</city>
        <address>Test Street 1</address>
        <zipCode>010101</zipCode>
        <phone>0700000000</phone>
        <expectedMessage>Your order has been successfully processed!</expectedMessage>
    </guestOrder>

    <!-- Billing address with every field empty: field name on the page -> expected message -->
    <emptyBillingAddress>
        <category>Books</category>
        <productName>Health Book</productName>
        <expectedErrors>
            <FirstName>First name is required.</FirstName>
            <LastName>Last name is required.</LastName>
            <Email>Email is required.</Email>
            <CountryId>Country is required.</CountryId>
            <City>City is required</City>
            <Address1>Street address is required</Address1>
            <ZipPostalCode>Zip / postal code is required</ZipPostalCode>
            <PhoneNumber>Phone is required</PhoneNumber>
        </expectedErrors>
    </emptyBillingAddress>

    <termsNotAccepted>
        <category>Books</category>
        <productName>Health Book</productName>
        <expectedMessage>Please accept the terms of service before the next step.</expectedMessage>
    </termsNotAccepted>

    <emptyCartMessage>
        <expectedMessage>Your Shopping Cart is empty!</expectedMessage>
    </emptyCartMessage>
</dataSets>
